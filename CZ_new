        "CZECH DAIRY EXTRACTION SUMMARY"
    )

    print(
        "================================================="
    )


    total_questions = 0


    for cat in categories:

        print(
            f"\nCATEGORY: "
            f"{cat['category_name']}"
        )

        print(
            f"Questions: "
            f"{len(cat['questions'])}"
        )


        total_questions += (
            len(cat["questions"])
        )


        for q in cat[
            "questions"
        ]:

            print(
                f"  {q['number']} - "
                f"{q['question']}"
            )


