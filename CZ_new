def open_questionnaire():
    """Open the questionnaire using the already-authenticated Selenium session.

    HTTP Basic Auth is established by the initial login URL. Do NOT embed the
    credentials again in the questionnaire URL, because that can trigger a
    server-side error on the API-test site.
    """
    print("📋 Opening Czech Dairy cattle questionnaire...")
    driver.get(questionnaire_url)

    WebDriverWait(driver, 20).until(
        lambda d: d.execute_script("return document.readyState") == "complete"
    )

    WebDriverWait(driver, 20).until(
        EC.presence_of_element_located((By.TAG_NAME, "body"))
    )

    body_text = driver.find_element(By.TAG_NAME, "body").text.strip()

    print("📋 Questionnaire URL:", driver.current_url)
    print("📄 Page title:", driver.title)

    if "unexpected error" in body_text.lower():
        raise RuntimeError(
            "Biocheck returned a server error while opening the questionnaire."
        )

    if "/questionnaires/dairy-cattle-0" not in driver.current_url:
        raise RuntimeError(
            f"Questionnaire did not open. Current URL: {driver.current_url}"
        )

    print("✅ Czech Dairy cattle questionnaire page loaded.")



