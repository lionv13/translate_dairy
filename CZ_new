                )


            if q.get(
                "help_text"
            ):

                print(
                    "     Help:",
                    q["help_text"]
                )


            if q.get(
                "redirect"
            ):

                print(
                    "     Redirect:",
                    q["redirect"]
                )


    print(
        "\n---------------------------------"
    )

    print(
        "Total categories:",
        len(categories)
    )

    print(
        "Total questions:",
        total_questions
    )

    print(
        "---------------------------------"
    )


