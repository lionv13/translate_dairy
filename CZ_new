def set_text_input_value(
    driver,
    field,
    value,
    label="field"
):

    """
    Reliably set a normal HTML text input.

    JavaScript is used because Drupal fields may not always
    respond correctly to Selenium clear()/send_keys().
    """

    value = str(value or "")

    try:

        driver.execute_script(
            """
            arguments[0].scrollIntoView({
                block:'center'
            });
            """,
            field
        )

        driver.execute_script(
            """
            const el = arguments[0];
            const value = arguments[1];

            el.focus();

            el.value = value;

            el.setAttribute(
                'value',
                value
            );

            el.dispatchEvent(
                new Event(
                    'input',
                    {bubbles: true}
                )
            );

            el.dispatchEvent(
                new Event(
                    'change',
                    {bubbles: true}
                )
            );

            el.blur();
            """,
            field,
            value
        )

        print(
            f"✅ Set {label}: {value}"
        )

        return True

    except Exception as e:

        print(
            f"⚠️ Could not set {label}: {e}"
        )

        return False


