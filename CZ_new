def normalize_text(text):
    """
    Normalize spaces coming from Word while preserving
    Czech characters.
    """

    if text is None:
        return ""

    text = str(text)

    text = text.replace("\xa0", " ")

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


def is_instruction_text(text):
    """
    Detect Word instructions that must NOT be inserted
    as potential answers.
    """

    if not text:
        return True

    cleaned = normalize_text(text).lower()

    skip_texts = {

        # ---------------- Czech ----------------

        "vyberte jednu z možností",
        "vyberte jednu z možností.",
        

        "vyberte všechny možnosti, které platí",
        "vyberte všechny možnosti, které platí.",

        "označte všechny možnosti, které platí",
        "označte všechny možnosti, které platí.",

        "zaškrtněte všechny platné možnosti",
        "zaškrtněte všechny platné možnosti.",

        # ---------------- English fallback ----------------

        "select one option",
        "select one option.",

        "mark all applicable options",
        "mark all applicable options.",

        "check any that apply",
        "check any that apply.",

        # ---------------- Portuguese fallback ----------------

        "selecione uma opção",
        "selecione uma opção.",

        "marque todas as opções aplicáveis",
        "marque todas as opções aplicáveis."
    }

    return cleaned in skip_texts


def is_checkbox_instruction_question(question_text):
    """
    Detect special checkbox instruction questions.
    """

    if not question_text:
        return False

    cleaned = normalize_text(question_text).lower()

    return cleaned in {

        # Czech
        "vyberte všechny možnosti, které platí",
        "vyberte všechny možnosti, které platí.",

        "označte všechny možnosti, které platí",
        "označte všechny možnosti, které platí.",

        "zaškrtněte všechny platné možnosti",
        "zaškrtněte všechny platné možnosti.",

        # English
        "mark all applicable options",
        "mark all applicable options.",

        "check any that apply",
