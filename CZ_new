def process_items(
    driver,
    categories
):

    print(
        "\n🔧 Starting to process "
        "Czech Dairy items..."
    )


    all_category_names = [

        cat["category_name"]

        for cat in categories

    ]


    all_questions = [

        q

        for cat in categories

        for q in cat["questions"]

    ]


    item_index = 0
    question_index = 0
    category_index = 0


    total_items = (

        len(all_category_names)
        +
        len(all_questions)

    )


    print(
        "Total categories:",
        len(all_category_names)
    )

    print(
        "Total questions:",
        len(all_questions)
    )

    print(
        "Total items:",
        total_items
    )


    # =========================================================
    # Main loop
    # =========================================================

    while item_index < total_items:

        try:

            print(
                f"\n🔍 Processing item "
                f"{item_index + 1}/"
                f"{total_items}..."
            )


            # -------------------------------------------------
            # Open translation page
            # -------------------------------------------------

            translate_link = WebDriverWait(
                driver,
                10
            ).until(

                EC.element_to_be_clickable(

                    (
                        By.XPATH,

                        f"(//tr[td]//a"
                        f"[text()='Translate'])"
                        f"[{item_index + 1}]"
                    )

                )

            )


            try:

                translate_link.click()

            except StaleElementReferenceException:

                translate_link = WebDriverWait(
                    driver,
                    5
                ).until(

                    EC.element_to_be_clickable(

                        (
                            By.XPATH,

                            f"(//tr[td]//a"
                            f"[text()='Translate'])"
                            f"[{item_index + 1}]"
                        )

                    )

                )

                translate_link.click()


            # -------------------------------------------------
            # Find Czech translation row
            # -------------------------------------------------

            row = WebDriverWait(
                driver,
                10
            ).until(

                EC.presence_of_element_located(

                    (
                        By.XPATH,

                        "//tr["
                        "td//*[contains("
                        "normalize-space(.), "
                        f"'{TARGET_LANGUAGE}'"
                        ")] "
                        "or "
                        "td[contains("
                        "normalize-space(.), "
                        f"'{TARGET_LANGUAGE}'"
                        ")]"
                        "]"
                    )

                )

            )


            # -------------------------------------------------
            # Edit existing Czech translation
            # -------------------------------------------------

            edit_links = row.find_elements(

                By.XPATH,

                ".//a[contains("
                "@href, '/edit'"
                ")]"

            )


            if edit_links:

                edit_links[0].click()

                print(
                    "✏️ Clicked Czech 'Edit'"
                )


            # -------------------------------------------------
            # Or add Czech translation
            # -------------------------------------------------

            else:

                add_links = row.find_elements(

                    By.XPATH,

                    ".//a[contains("
                    "@href, '/add'"
                    ")]"

                )


                if add_links:

                    add_links[0].click()

                    print(
                        "➕ Clicked Czech 'Add'"
                    )

                else:

                    print(
                        "⚠️ No Edit/Add link "
                        "found for Czech."
                    )

                    item_index += 1

                    driver.get(
                        questionnaire_url
                    )

                    continue


            # -------------------------------------------------
            # Wait for edit form
            # -------------------------------------------------

            WebDriverWait(
                driver,
                10
            ).until(

                EC.presence_of_element_located(
                    (
                        By.TAG_NAME,
                        "form"
                    )
                )

            )


            labels = driver.find_elements(
                By.XPATH,
                "//label"
            )


            item_filled = False


            # =================================================
            # PROCESS PAGE LABELS
            # =================================================

            for label in labels:

                label_text = (
                    label.text.strip()
                )

                input_id = (
                    label.get_attribute(
                        "for"
                    )
                )


                if not input_id:
                    continue


                # =============================================
                # CATEGORY
                # =============================================

                if (
                    "Category name"
                    in label_text
                    and
                    category_index
                    < len(all_category_names)
                ):

                    field = (
                        driver.find_element(
                            By.ID,
                            input_id
                        )
                    )

                    set_text_input_value(

                        driver,

                        field,

                        all_category_names[
                            category_index
                        ],

                        label="category"

                    )

                    print(
                        "🏷️ Set Czech category: "
                        f"{all_category_names[category_index]}"
                    )

                    category_index += 1

                    item_filled = True

                    break


                # =============================================
                # QUESTION
                # =============================================

                label_text_lower = (
                    label_text.lower()
                )


                is_main_question_field = (

                    "question"
                    in label_text_lower

                    and

                    "identifier"
                    not in label_text_lower

                    and

                    "sequence"
                    not in label_text_lower

                )


                if (
                    is_main_question_field
                    and
                    question_index
                    < len(all_questions)
                ):

                    current = (
                        all_questions[
                            question_index
                        ]
                    )


                    question_text = (
                        clean_question_text(
                            current["question"]
                        )
                    )


                    field = (
                        driver.find_element(
                            By.ID,
                            input_id
                        )
                    )


                    # -----------------------------------------
                    # Special checkbox question
                    # -----------------------------------------

                    if (
                        is_checkbox_instruction_question(
                            question_text
                        )
                    ):

                        fill_question_identifier(

                            driver,

                            current.get(
                                "number"
                            )

                        )


                    # -----------------------------------------
                    # Set question text
                    # -----------------------------------------

                    set_text_input_value(

                        driver,

                        field,

                        question_text,

                        label=(
                            "Czech question "
                            f"{current.get('number')}"
                        )

                    )


                    print(
                        f"❓ Set Czech question "
                        f"{current.get('number')}: "
                        f"{question_text}"
                    )


                    # =========================================
                    # MATRIX
                    # =========================================

                    if current.get(
                        "statements"
                    ):

                        print(
                            "📐 Matrix question "
                            "detected."
                        )

                        fill_matrix_question(
                            driver,
                            current
                        )


                    # =========================================
                    # STANDARD QUESTION
                    # =========================================

                    else:

                        print(
                            "🅰️ Standard question "
                            "detected."
                        )


                        answers = [

                            normalize_text(a)

                            for a in current.get(
                                "answers",
                                []
                            )

                            if not is_instruction_text(
                                normalize_text(a)
                            )

                        ]


                        print(
                            "Answers extracted:"
                        )

                        for idx, ans in enumerate(
                            answers
                        ):

                            print(
                                f"  {idx + 1}: "
                                f"{ans}"
                            )


                        # -------------------------------------
                        # Find potential answer fields
                        # -------------------------------------

                        answer_fields = (
                            driver.find_elements(

                                By.CSS_SELECTOR,

                                'input['
                                'id^="edit-field-'
                                'potential-answers-"'
                                '][id$="-value"]'

                            )
                        )


                        available_count = (
                            len(answer_fields)
                        )


                        print(
                            f"Word answers: "
                            f"{len(answers)}"
                        )

                        print(
                            f"Form answer fields: "
                            f"{available_count}"
                        )


                        # -------------------------------------
                        # Detect mismatch
                        # -------------------------------------

                        if (
                            len(answers)
                            >
                            available_count
                        ):

                            print(
                                "⚠️ Word contains "
                                f"{len(answers)} answers "
                                "but form contains only "
                                f"{available_count} fields."
                            )

                            print(
                                "⚠️ Missing answer fields "
                                "for:"
                            )

                            for missing in (
                                answers[
                                    available_count:
                                ]
                            ):

                                print(
                                    f"   - {missing}"
                                )


                        # -------------------------------------
                        # Fill answers
                        # -------------------------------------

                        for i, ans in enumerate(
                            answers[
                                :available_count
                            ]
                        ):

                            try:

                                ans_field = (
                                    WebDriverWait(
                                        driver,
                                        10
                                    ).until(

                                        EC.presence_of_element_located(

                                            (
                                                By.ID,

                                                "edit-field-"
                                                "potential-"
                                                "answers-"
                                                f"{i}-value"
                                            )

                                        )

                                    )
                                )


                                set_text_input_value(

                                    driver,

                                    ans_field,

                                    ans,

                                    label=(
                                        f"Czech answer "
                                        f"{i + 1}"
                                    )

                                )


                            except Exception as e:

                                print(
                                    "⚠️ Could not set "
                                    f"answer {i + 1}: "
                                    f"{ans} -> {e}"
                                )


                    # =========================================
                    # HELP TEXT
                    # =========================================

                    if current.get(
                        "help_text"
                    ):

                        fill_ckeditor5_field(

                            driver,

                            "edit-help-0-value",

                            current[
                                "help_text"
                            ],

                            label="Czech Help text"

                        )

                    else:

                        fill_ckeditor5_field(

                            driver,

                            "edit-help-0-value",

                            "",

                            label=(
                                "Czech Help text "
                                "cleared"
                            )

                        )


                    # =========================================
                    # REDIRECT
                    # =========================================

                    if current.get(
                        "redirect"
                    ):

                        fill_ckeditor5_field(

                            driver,

                            "edit-conditional-help-0-value",

                            current[
                                "redirect"
                            ],

                            label="Czech Redirect"

                        )

                    else:

                        fill_ckeditor5_field(

                            driver,

                            "edit-conditional-help-0-value",

                            "",

                            label=(
                                "Czech Redirect "
                                "cleared"
                            )

                        )


                    question_index += 1

                    item_filled = True

                    break


            # =================================================
            # SAVE ITEM
            # =================================================

            if not item_filled:

                print(
                    "⚠️ WARNING: No category/question "
                    "field was recognized on this page."
                )


            save_button = WebDriverWait(
                driver,
                20
            ).until(

                EC.element_to_be_clickable(
                    (
                        By.ID,
                        "edit-submit"
                    )
                )

            )


            driver.execute_script(

                """
                arguments[0].scrollIntoView({
                    block:'center'
                });
                """,

                save_button

            )


            time.sleep(1)


            driver.execute_script(

                "arguments[0].click();",

                save_button

            )


            print(
                "💾 Clicked Save"
            )


            item_index += 1


            time.sleep(2)


            driver.get(
                questionnaire_url
            )


        # =====================================================
        # ERROR HANDLING
        # =====================================================

        except Exception as e:

            print(
                f"\n❌ Error at item "
                f"{item_index + 1}: {e}"
            )


            item_index += 1


            try:

                driver.get(
                    questionnaire_url
                )

                time.sleep(2)

            except Exception:

                pass


            continue


