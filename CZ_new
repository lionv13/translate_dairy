# =============================================================
# ------------------ EXTRACT DATA FROM WORD -------------------
# =============================================================

def extract_data(file_path):

    # ---------------------------------------------------------
    # Patterns
    # ---------------------------------------------------------

    CATEGORY_PATTERN = (
        r'^(~|[A-M])\.\s*(.*)'
    )

    NUMERIC_PATTERN = (
        r'^(\d+[a-zA-Z]?)\.\s*(.*)'
    )

    ROMAN_PATTERN = (
        r'^([IVXLCDM]+)\.\s*(.*)'
    )

    BULLET_PATTERN = (
        r'^[\u25A1\u25CB•▪○]+\s*'
    )


    # ---------------------------------------------------------
    # Czech redirect instructions
    # ---------------------------------------------------------

    REDIRECT_MSG_PATTERN = re.compile(

        r'('

        # přejděte na otázku č. 17
        r'\bpřejděte\s+na\s+otázku\s+'
        r'č\.?\s*[IVXLCDM0-9]+[a-zA-Z]?'

        r'|'

        # přejděte na otázku 17
        r'\bpřejděte\s+na\s+otázku\s+'
        r'[IVXLCDM0-9]+[a-zA-Z]?'

        r'|'

        # přejděte na další otázku
        r'\bpřejděte\s+na\s+další\s+otázku'

        r'|'

        # přejděte na konec
        r'\bpřejděte\s+na\s+konec'

        r'|'

        # pokračujte otázkou č. X
        r'\bpokračujte\s+otázkou\s+'
        r'č\.?\s*[IVXLCDM0-9]+[a-zA-Z]?'

        r'|'

        # pokračujte na otázku č. X
        r'\bpokračujte\s+na\s+otázku\s+'
        r'č\.?\s*[IVXLCDM0-9]+[a-zA-Z]?'

        r')',

        re.IGNORECASE
    )


    # ---------------------------------------------------------
    # Open Word
    # ---------------------------------------------------------

    doc = docx.Document(
        file_path
    )


    # ---------------------------------------------------------
    # Preserve document order:
    # paragraphs + tables
    # ---------------------------------------------------------

    blocks = []

    for element in doc.element.body:

        if element.tag.endswith(
            '}p'
        ):

            blocks.append(

                docx.text.paragraph.Paragraph(
                    element,
                    doc
                )

            )

        elif element.tag.endswith(
            '}tbl'
        ):

            blocks.append(

                docx.table.Table(
                    element,
                    doc
                )

            )


    # ---------------------------------------------------------
    # Storage
    # ---------------------------------------------------------

    categories = []
    questions = []

    current_category = None
    current_question = None
    current_number = None

    current_answers = []

    current_help_text = ""
    current_redirect = ""


    # ---------------------------------------------------------
    # Save question
    # ---------------------------------------------------------

    def save_current_question():

        nonlocal current_question
        nonlocal current_number
        nonlocal current_answers
        nonlocal current_help_text
        nonlocal current_redirect
        nonlocal questions

        if current_question:

            questions.append({

                "question":
                    current_question.strip(),

                "answers":
                    current_answers,

                "redirect":
                    current_redirect.strip(),

                "help_text":
                    current_help_text.strip(),

                "number":
                    current_number

            })

        current_question = None
        current_number = None

        current_answers = []

        current_help_text = ""
        current_redirect = ""


    # ---------------------------------------------------------
    # Save category
    # ---------------------------------------------------------

    def save_current_category():

        nonlocal current_category
        nonlocal questions
        nonlocal categories

        if current_category is not None:

            categories.append({

                "category_name":
                    current_category,

                "questions":
                    questions

            })

        questions = []


    # ---------------------------------------------------------
    # Parse Word blocks
    # ---------------------------------------------------------

    for block in blocks:

        # =====================================================
        # PARAGRAPH
        # =====================================================

        if isinstance(
            block,
            docx.text.paragraph.Paragraph
        ):

            text = normalize_text(
                block.text
            )


            # -------------------------------------------------
            # Remove Czech required-question marker from the question text.
            # Example: "1. Otázka? (povinný dotaz)" -> "1. Otázka?"
            text = re.sub(
                r'\s*\(\s*povinný\s+dotaz\s*\)\s*',
                ' ',
                text,
                flags=re.IGNORECASE
            )

            text = normalize_text(
                text
            )


            if not text:
                continue


            # -------------------------------------------------
            # Font size
            # -------------------------------------------------

            font_size = None

            if (
                block.runs
                and block.runs[0].font.size
            ):

                font_size = (
                    block.runs[0]
                    .font.size.pt
                )


            # -------------------------------------------------
            # IMPORTANT:
            # Czech Dairy introductory category
            # -------------------------------------------------

            if (
                normalize_text(text).lower()
                == "údaje o hospodářství"
            ):

                save_current_question()
                save_current_category()

                current_category = (
                    "Údaje o hospodářství"
                )

                print(
                    "\n🏷️ Found introductory category: "
                    "Údaje o hospodářství"
                )

                continue


            # -------------------------------------------------
            # Category detection
            # -------------------------------------------------

            # Category headings in this Word file are not reliably 16 pt.
            # Detect them by their Czech title instead. This prevents C., D.
            # and I. from being misread as Roman-numbered questions.
            category_match = re.match(
                r'^([A-J])[.\-–—]\s*(.+)$',
                text,
                flags=re.IGNORECASE
            )

            is_dairy_category = False
            category_title = None
            category_letter = None

            if category_match:
                category_letter = category_match.group(1).upper()
                category_title = normalize_text(category_match.group(2))
                if category_title.lower() in DAIRY_CATEGORY_TITLES:
                    is_dairy_category = True

            if is_dairy_category:
                save_current_question()
                save_current_category()

                current_category = category_title

                print(
                    f"\n🏷️ Found category {category_letter}: "
                    f"{current_category}"
                )
                continue

            # Only test for a question after excluding known category headings.
            question_match = (
                re.match(NUMERIC_PATTERN, text)
                or re.match(ROMAN_PATTERN, text)
            )


            # -------------------------------------------------
            # Question detection
            # -------------------------------------------------

            if (
                question_match
                and current_category is not None
            ):

                save_current_question()

                current_number = (
                    question_match
                    .group(1)
                    .strip()
                )

                current_question = (
                    question_match
                    .group(2)
                    .strip()
                )

                print(
                    f"❓ Found question "
                    f"{current_number}: "
                    f"{current_question}"
                )

                continue


            # -------------------------------------------------
            # Ignore instruction
            # -------------------------------------------------

            if is_instruction_text(
                text
            ):
                continue


            # -------------------------------------------------
            # Answer options
            # -------------------------------------------------

            if (
                block.style.name.startswith(
                    "List"
                )
                or
                re.match(
                    BULLET_PATTERN,
                    text
                )
            ):

                answer_text = re.sub(
                    BULLET_PATTERN,
                    "",
                    text
                )

                answer_text = normalize_text(
                    answer_text
                )

                if is_instruction_text(
                    answer_text
                ):
                    continue

                if answer_text:

                    current_answers.append(
                        answer_text
                    )

                continue


            # -------------------------------------------------
            # Redirect
            # -------------------------------------------------

            if re.search(
                REDIRECT_MSG_PATTERN,
                text
            ):

                current_redirect += (
                    " " + text
                )

                continue


            # -------------------------------------------------
            # Remaining text after a question is treated
            # as HELP TEXT.
            #
            # This is much safer for Czech than the previous
            # Portuguese word-marker approach.
            # -------------------------------------------------

            if (
                current_question is not None
                and
                not question_match
            ):

                # Avoid obvious page labels
                if not re.match(
                    r'^strana\s*\|\s*\d+$',
                    text,
                    flags=re.IGNORECASE
                ):

                    current_help_text += (
                        " " + text
                    )


        # =====================================================
        # TABLE / MATRIX
        # =====================================================

        elif (
            isinstance(
                block,
                Table
            )
            and
            current_question
        ):

            headers = []
            statements = []


            for i, row in enumerate(
                block.rows
            ):

                cells = [

                    normalize_text(
                        cell.text
                    )

                    for cell in row.cells

                ]


                # ---------------------------------------------
                # Header row
                # ---------------------------------------------

                if i == 0:

                    headers = [

                        c
                        for c in cells

                        if (
                            c
                            and
                            not is_instruction_text(c)
                        )

                    ]


                # ---------------------------------------------
                # Statement rows
                # ---------------------------------------------

                else:

                    non_empty_cells = [

                        c
                        for c in cells
                        if c

                    ]

                    if non_empty_cells:

                        # First meaningful cell generally
                        # contains the statement.
                        statement = (
                            non_empty_cells[0]
                        )

                        if statement:

                            statements.append(
                                statement
                            )


            # -------------------------------------------------
            # Save matrix
            # -------------------------------------------------

            if (
                headers
                and
                statements
            ):

                questions.append({

                    "question":
                        current_question.strip(),

                    "answers":
                        headers,

                    "statements":
                        statements,

                    "redirect":
                        current_redirect.strip(),

                    "help_text":
                        current_help_text.strip(),

                    "number":
                        current_number

                })

                print(
                    f"📐 Matrix extracted: "
                    f"{current_number}"
                )

                print(
                    "   Options:",
                    headers
                )

                print(
                    "   Statements:",
                    statements
                )


                current_question = None
                current_number = None

                current_answers = []

                current_help_text = ""
                current_redirect = ""


    # ---------------------------------------------------------
    # Save final question/category
    # ---------------------------------------------------------

    save_current_question()

    if (
        current_category is not None
        and questions
    ):

        categories.append({

            "category_name":
                current_category,

            "questions":
                questions

        })


    return categories


# =============================================================
