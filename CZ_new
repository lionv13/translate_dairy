    }


def clean_question_text(question_text):
    """
    Remove question number when the number is accidentally
    included in the extracted question text.

    Examples:
        1. Question
        7a. Question
        I. Question
        IX. Question
    """

    return re.sub(
        r'^(\d+[a-zA-Z]?|[IVXLCDM]+)[\.\)]\s*',
        '',
        question_text or '',
        flags=re.IGNORECASE
    ).strip()


