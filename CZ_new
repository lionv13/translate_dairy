def inloggen():
    # Keep the same test-login mechanism supplied by the user.
    # The questionnaire is used as Drupal's destination so that we do not
    # perform a second navigation that can lose/re-trigger HTTP Basic Auth.
    destination = "/en/questionnaires/dairy-cattle-0"
    url = (
        f"https://{username_http}:{password_http}@apitest.biocheckgent.com"
        f"/en/user/login?destination={destination}"
    )
    driver.get(url)

    try:
        name_input = WebDriverWait(driver, 10).until(
            EC.presence_of_element_located((By.ID, "edit-name"))
        )
        name_input.clear()
        name_input.send_keys(username_form)

        pass_input = driver.find_element(By.ID, "edit-pass")
        pass_input.clear()
        pass_input.send_keys(password_form, Keys.RETURN)

        # Wait for Drupal to leave the login page and follow the destination.
        WebDriverWait(driver, 20).until(
            lambda d: "/user/login" not in d.current_url
