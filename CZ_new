        WebDriverWait(driver, 20).until(
            lambda d: d.execute_script("return document.readyState") == "complete"
        )

        print("✅ Login completo.")
        print("Current URL:", driver.current_url)

        body_text = driver.find_element(By.TAG_NAME, "body").text.strip()
        if "unexpected error" in body_text.lower():
            raise RuntimeError("Biocheck returned a server error after login.")

        if "/questionnaires/dairy-cattle-0" not in driver.current_url:
            raise RuntimeError(
                "Login succeeded, but Drupal did not redirect to the questionnaire. "
                f"Current URL: {driver.current_url}"
            )

        print("✅ Dairy cattle questionnaire reached through login destination.")

    except TimeoutException:
        print("❌ No se encontró el formulario de login o no terminó la redirección.")
        raise


